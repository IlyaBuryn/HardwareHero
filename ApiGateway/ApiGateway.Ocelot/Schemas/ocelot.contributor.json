{
  "Routes": [
    // Contributors
    {
      "UpstreamPathTemplate": "/contributor/sign-up",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/sign-up"
    },

    {
      "UpstreamPathTemplate": "/contributor/{contributorId}",
      "UpstreamHttpMethod": [ "Delete" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/{contributorId}"
    },

    {
      "UpstreamPathTemplate": "/contributor/{param}",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/{param}"
    },

    {
      "UpstreamPathTemplate": "/contributor",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor"
    },

    {
      "UpstreamPathTemplate": "/contributor/{contributorId}/confirm-info",
      "UpstreamHttpMethod": [ "Get", "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/{contributorId}/confirm-info"
    },

    // Contributor Excellences
    {
      "UpstreamPathTemplate": "/contributor/{contributorId}/excellence",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/{contributorId}/excellence"
    },

    {
      "UpstreamPathTemplate": "/contributor/excellence",
      "UpstreamHttpMethod": [ "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/excellence"
    },

    {
      "UpstreamPathTemplate": "/contributor/excellence/{name}",
      "UpstreamHttpMethod": [ "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/contributor/excellence/{name}"
    },

    // Contributor References
    {
      "UpstreamPathTemplate": "/references/region",
      "UpstreamHttpMethod": [ "Post", "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/region"
    },

    {
      "UpstreamPathTemplate": "/references/regions",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/regions"
    },

    {
      "UpstreamPathTemplate": "/references/region/countries",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/region/countries"
    },

    {
      "UpstreamPathTemplate": "/references/region/countries/{city}",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/region/countries/{city}"
    },

    {
      "UpstreamPathTemplate": "/references/region/{country}",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/region/{country}"
    },

    {
      "UpstreamPathTemplate": "/references/currency",
      "UpstreamHttpMethod": [ "Post", "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/currency"
    },

    {
      "UpstreamPathTemplate": "/references/currencies",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/references/currencies"
    },

    // Contributors Subscriptions
    {
      "UpstreamPathTemplate": "/subscription-plan",
      "UpstreamHttpMethod": [ "Post", "Put", "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/subscription-plan"
    },

    {
      "UpstreamPathTemplate": "/subscription-plan/{subscriptionPlanId}",
      "UpstreamHttpMethod": [ "Delete" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/subscription-plan/{subscriptionPlanId}"
    },

    {
      "UpstreamPathTemplate": "/subscription-plan/contributor/{contributorId}/subscribe/{subscriptionPlanId}",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/subscription-plan/contributor/{contributorId}/subscribe/{subscriptionPlanId}"
    },

    {
      "UpstreamPathTemplate": "/subscription-plan/contributor/{contributorId}/unsubscribe",
      "UpstreamHttpMethod": [ "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/subscription-plan/contributor/{contributorId}/unsubscribe"
    },

    // Contributors Chat
    {
      "UpstreamPathTemplate": "/chat",
      "UpstreamHttpMethod": [ "Post", "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/chat"
    },

    {
      "UpstreamPathTemplate": "/chat/{chatRoomId}",
      "UpstreamHttpMethod": [ "Delete", "Get", "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/chat/{chatRoomId}"
    },

    {
      "UpstreamPathTemplate": "/chat/contributor/{contributorId}",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/chat/contributor/{contributorId}"
    },

    {
      "UpstreamPathTemplate": "/chat/message",
      "UpstreamHttpMethod": [ "Post", "Put" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "contributor.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/chat/message"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:8070"
  }
}