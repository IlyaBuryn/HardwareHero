{
  "Routes": [
    // Users
    {
      "UpstreamPathTemplate": "/users/user",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/users"
    },

    {
      "UpstreamPathTemplate": "/users/user/{userId}",
      "UpstreamHttpMethod": [ "Put", "Delete", "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/users/{userId}"
    },

    {
      "UpstreamPathTemplate": "/users",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/users"
    },

    // Roles
    {
      "UpstreamPathTemplate": "/users/roles/{roleName}",
      "UpstreamHttpMethod": [ "Post", "Delete" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/roles/{roleName}"
    },

    {
      "UpstreamPathTemplate": "/users/roles",
      "UpstreamHttpMethod": [ "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/roles"
    },

    {
      "UpstreamPathTemplate": "/users/{roleName}/{userId}",
      "UpstreamHttpMethod": [ "Delete" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/roles/{roleName}/{userId}"
    },

    {
      "UpstreamPathTemplate": "/users/{userId}/{roleName}",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/roles/{userId}/{roleName}"
    },

    {
      "UpstreamPathTemplate": "/users/{userId}/roles",
      "UpstreamHttpMethod": [ "Post" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/roles/{userId}/roles"
    },

    // WishList
    {
      "UpstreamPathTemplate": "/users/{userId}/wishlist",
      "UpstreamHttpMethod": [ "Post", "Delete", "Get" ],

      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 80
        }
      ],
      "DownstreamPathTemplate": "/api/wishlist/{userId}"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:8070"
  }
}