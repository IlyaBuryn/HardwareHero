{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://els:9200"
  },
  "ConnectionStrings": {
    "AggregatorDbConnection": "Server=hardwarehero.mssql;Database=HardwareHero.AggregatorDb;User Id=sa;Password=password@#12345;TrustServerCertificate=True;"
  },
  "PageSizeOptions": {
    "PageSize": 15,
    "DefaultPageNumber": 1
  },
  "KafkaConfig": {
    "BootstrapServers": "kafka1:9092",
    "GroupId": "aggregator-group",
    "AllowAutoCreateTopics": true
  }
}