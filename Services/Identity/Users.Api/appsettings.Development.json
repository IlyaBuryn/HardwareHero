{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://els:9200"
  },
  "ConnectionStrings": {
    "UsersDatabaseConnection": "Server=hardwarehero.mssql;Database=HardwareHero.Users;User Id=sa;Password=password@#12345;TrustServerCertificate=True;"
  },
  "EventKafkaConfig": {
    "BootstrapServers": "kafka1:9092",
