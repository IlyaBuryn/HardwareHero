{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://els:9200"
  },
  "MailMongoDatabase": {
    "ConnectionString": "mongodb://hardwarehero.mongo:27017",
    "DatabaseName": "Mail"
  },
  "MailEvents": {
    "BootstrapServers": "kafka1:9092",
    "GroupId": "aggregator-group",
    "AllowAutoCreateTopics": true
  }
}
