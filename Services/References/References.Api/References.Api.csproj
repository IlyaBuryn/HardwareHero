    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>da8291fc-d30a-4c6f-b599-c7a81ac2f37e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
