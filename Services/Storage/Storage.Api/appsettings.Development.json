{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://els:9200"
  },
  "EventKafkaConfig": {
    "BootstrapServers": "kafka1:9092",
    "GroupId": "event-group",
    "AllowAutoCreateTopics": true
  },
  "MessageKafkaConfig": {
    "BootstrapServers": "kafka2:9082",
    "GroupId": "message-group",
    "AllowAutoCreateTopics": true
  }
  //"Storage": {
  //  "BaseUrl": "http://localhost:5021/files",
  //  "BasePath" "/data/files"
  //}
}
